# Klient (publiczne — bezpieczne w bundlu; dostęp chroni RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tylko serwer (Vercel → Project Settings → Environment Variables). NIE dawaj prefiksu VITE_.
GEMINI_API_KEY=
# Opcjonalnie: model główny (domyślnie gemini-flash-lite-latest; zapasowy: gemini-flash-latest)
# GEMINI_MODEL=
# Opcjonalnie: klucz YouTube Data API v3 (Google Cloud → APIs → YouTube Data API v3 → Credentials → API key).
# Pewniejszy odczyt opisów filmów z serwera Vercel, gdy YouTube blokuje pobieranie strony filmu.
# YOUTUBE_API_KEY=
